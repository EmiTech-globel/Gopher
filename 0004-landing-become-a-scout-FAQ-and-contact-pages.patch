+.faq details { background: #fff; border-radius: 16px; padding: 20px 24px; }
+.faq summary { cursor: pointer; font-weight: 700; font-size: 17px; color: var(--s-deep); }
+.faq p { margin-top: 12px; font-size: 15px; }
+.faq .lead { margin-bottom: 16px; }
+.contact { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; margin-top: 32px; }
+.contact-cards { flex: 1 1 320px; display: flex; flex-direction: column; gap: 16px; }
+.info { background: #fff; border-radius: 20px; padding: 22px 26px; }
+.info .label { font-size: 13px; font-weight: 700; color: var(--s-muted); letter-spacing: 0.06em; }
+.info .value { font-weight: 600; color: var(--s-deep); margin-top: 4px; }
+.form { flex: 1 1 380px; background: #fff; border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 14px; }
+.form h2 { font-size: 26px; margin-bottom: 4px; }
+.form input, .form textarea { border: 1.5px solid var(--s-line); border-radius: 12px; padding: 14px 16px; font: inherit; color: var(--s-ink); background: #fff; }
+.form textarea { min-height: 130px; resize: vertical; }
+.form button { border: 0; cursor: pointer; justify-content: center; }
