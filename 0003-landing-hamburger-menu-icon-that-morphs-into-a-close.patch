From 86a7cc3701e1ac71a6046f96ed970d8d9181318d Mon Sep 17 00:00:00 2001
From: TrixStudio <trixstudio@users.noreply.github.com>
Date: Sat, 21 Nov 2026 15:35:22 +0000
Subject: [PATCH 3/4] landing: hamburger menu icon that morphs into a close
 icon

---
 apps/landing/src/components/SiteLayout.tsx | 5 ++++-
 apps/landing/src/site.css                  | 7 ++++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/apps/landing/src/components/SiteLayout.tsx b/apps/landing/src/components/SiteLayout.tsx
index 2f0bf41..ac8c391 100644
--- a/apps/landing/src/components/SiteLayout.tsx
+++ b/apps/landing/src/components/SiteLayout.tsx
@@ -20,7 +20,10 @@ export function SiteLayout({ children }: { children: ReactNode }) {
             Download
           </a>
           <details className="menu">
-            <summary>Menu</summary>
+            <summary aria-label="Menu">
+              <span />
+              <span />
+            </summary>
             <div className="menu-list">
               {NAV_LINKS.map((l) => (
                 <a key={l.href} href={l.href}>
diff --git a/apps/landing/src/site.css b/apps/landing/src/site.css
index b13f871..4862bae 100644
--- a/apps/landing/src/site.css
+++ b/apps/landing/src/site.css
@@ -22,7 +22,12 @@ img { max-width: 100%; }
 .nav-links { display: flex; gap: 28px; font-weight: 600; font-size: 15px; }
 .nav-right { display: flex; align-items: center; gap: 12px; }
 .menu { display: none; }
-.menu summary { cursor: pointer; list-style: none; font-weight: 700; font-size: 14px; color: var(--s-plum); padding: 11px 16px; border-radius: 999px; background: #fff; }
+.menu summary { cursor: pointer; list-style: none; width: 46px; height: 46px; border-radius: 50%; background: #fff; box-shadow: 0 2px 10px rgba(46, 18, 75, 0.08); display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 6px; padding-right: 12px; }
+.menu summary span { display: block; height: 2px; border-radius: 2px; background: var(--s-plum); transition: transform 0.25s ease, width 0.25s ease; }
+.menu summary span:first-child { width: 22px; }
+.menu summary span:last-child { width: 14px; }
+.menu[open] summary span:first-child { transform: translateY(4px) rotate(45deg); }
+.menu[open] summary span:last-child { width: 22px; transform: translateY(-4px) rotate(-45deg); }
 .menu summary::-webkit-details-marker { display: none; }
 .menu-list { position: absolute; right: 24px; top: 72px; z-index: 5; background: #fff; border-radius: 18px; padding: 10px 6px; box-shadow: 0 18px 40px rgba(46, 18, 75, 0.18); display: flex; flex-direction: column; min-width: 210px; font-weight: 600; }
 .menu-list a { padding: 10px 16px; }
-- 
