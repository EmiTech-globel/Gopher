# Public — safe to expose to the browser, same values as apps/mobile's env
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never referenced from a
# Client Component. Used exclusively in app/(dashboard)/disputes/actions.ts
# and app/(dashboard)/payouts/actions.ts to call Paystack (refunds, transfers).
# Same key already used by supabase/functions/paystack-webhook.
PAYSTACK_SECRET_KEY=

# Server-only — same NEVER-NEXT_PUBLIC_ rule. Used exclusively in
# lib/supabase/admin.ts to call the Auth Admin API (revoking a
# misbehaving account's sign-in access from Accounts). Find this in
# Supabase Dashboard -> Project Settings -> API -> service_role key.
# This key bypasses RLS entirely — treat it with the same care as a
# database root password, never log it, never send it to the client.
SUPABASE_SERVICE_ROLE_KEY=
